# Activation settings applied to rtl8730e/loadable_ext_ddr_st7785 only.
# Board boot/sleep/reset and timing validation is still required.
CONFIG_HEALTH_MONITOR=y
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_FOR_IRQ=y
CONFIG_WATCHDOG_FOR_IRQ_INTERVAL=5000
# configure.sh copies defconfig without evaluating Kconfig selects.
CONFIG_ARCH_HAVE_WDOG_WAKEUP=y
