new file mode 100644
index 000000000..d9edf46f1
--- /dev/null
+++ b/os/kernel/health_monitor/health_monitor.h
@@ -0,0 +1,158 @@
+/****************************************************************************
+ *
+ * Copyright 2026 Samsung Electronics All Rights Reserved.
