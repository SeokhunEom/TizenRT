diff --git a/os/arch/arm/src/armv8-m/up_exception.S b/os/arch/arm/src/armv8-m/up_exception.S
index 239e60c76..8ce812b99 100644
--- a/os/arch/arm/src/armv8-m/up_exception.S
+++ b/os/arch/arm/src/armv8-m/up_exception.S
@@ -414,0 +415,21 @@ exception_common:
+	/* Reproduction-only injection: pend TIMER0 after the software return context
+	 * is selected, while UART0 RX is still active, immediately before unmasking.
+	 */
+	mrs r0, ipsr
+	cmp r0, #48
+	bne .Luartlab_skip
+	ldr r0, =g_uartlab_armed
+	ldr r1, [r0]
+	cmp r1, #1
+	bne .Luartlab_skip
+	movs r1, #0
+	str r1, [r0]
+	ldr r0, =0xe000e200
+	movs r1, #8
+	str r1, [r0]
+	dsb
+	isb
+	.global uartlab_injected
+uartlab_injected:
+	nop
+.Luartlab_skip:
diff --git a/os/arch/arm/src/qemu-armv8m/qemu_armv8m_serial.c b/os/arch/arm/src/qemu-armv8m/qemu_armv8m_serial.c
index 60e2a8275..c5246e295 100644
--- a/os/arch/arm/src/qemu-armv8m/qemu_armv8m_serial.c
+++ b/os/arch/arm/src/qemu-armv8m/qemu_armv8m_serial.c
@@ -159,0 +160,9 @@ static int qemu_uart_interrupt(int irq, FAR void *context, FAR void *arg)
+	extern volatile uint32_t g_uartlab_armed, g_uartlab_rx_count, g_uartlab_mode;
+	if (irq == MPS2_IRQ_UART0_RX) {
+		g_uartlab_rx_count++;
+		if (g_uartlab_armed && g_uartlab_mode == 1) {
+			g_uartlab_armed = 0;
+			putreg32(1u << 3, 0xe000e200);
+			__asm__ volatile("dsb\n\tisb" ::: "memory");
+		}
+	}
diff --git a/os/arch/arm/src/qemu-armv8m/qemu_armv8m_timerisr.c b/os/arch/arm/src/qemu-armv8m/qemu_armv8m_timerisr.c
index fee4cfda5..d3b680654 100644
--- a/os/arch/arm/src/qemu-armv8m/qemu_armv8m_timerisr.c
+++ b/os/arch/arm/src/qemu-armv8m/qemu_armv8m_timerisr.c
@@ -56,0 +57,6 @@ static int qemu_armv8m_timerisr(int irq, FAR void *context, FAR void *arg)
+	extern volatile uint32_t g_uartlab_timer_count, g_uartlab_evidence[], g_uartlab_stage;
+	g_uartlab_timer_count++;
+#ifdef CONFIG_ARCH_NESTED_INTERRUPT
+	extern uint32_t g_nestlevel;
+	if (g_uartlab_stage == 2) g_uartlab_evidence[16] = g_nestlevel;
