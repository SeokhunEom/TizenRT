diff --git a/os/board/qemu-armv8m/src/qemu_uart_active_lab.c b/os/board/qemu-armv8m/src/qemu_uart_active_lab.c
new file mode 100644
index 000000000..d0b5a2b7a
--- /dev/null
+++ b/os/board/qemu-armv8m/src/qemu_uart_active_lab.c
@@ -0,0 +1,125 @@
+/* Disposable, opt-in UART active-state reproduction. Not a production fix. */
+#include <tinyara/config.h>
+#include <tinyara/arch.h>
+#include <tinyara/irq.h>
+#include <tinyara/sched.h>
+#include <tinyara/wdog.h>
+#include <arch/irq.h>
+#include <apps/shell/tash.h>
+#include <sched.h>
+#include <semaphore.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <unistd.h>
+#include "up_arch.h"
+#include "up_internal.h"
+#include <arch/chip/chip.h>
+
+volatile uint32_t g_uartlab_armed;
+volatile uint32_t g_uartlab_stage;
+volatile uint32_t g_uartlab_rx_count;
+volatile uint32_t g_uartlab_timer_count;
+volatile uint32_t g_uartlab_callback_count;
+volatile uint32_t g_uartlab_mode;
+volatile uint32_t g_uartlab_priority;
+volatile uint32_t g_uartlab_evidence[24];
+static sem_t g_gate;
+static WDOG_ID g_watchdog;
+static pid_t g_a_pid;
+static pid_t g_b_pid;
+
+void __attribute__((noinline)) uartlab_ready(void) { __asm__ volatile("nop" ::: "memory"); }
+void __attribute__((noinline)) uartlab_observe(void) { __asm__ volatile("nop" ::: "memory"); }
+void __attribute__((noinline)) uartlab_after_kill(void) { __asm__ volatile("nop" ::: "memory"); }
+
+static uint32_t ipsr(void)
+{
+    uint32_t value;
+    __asm__ volatile("mrs %0, ipsr" : "=r"(value));
+    return value;
+}
+
+static void wake_b(int argc, uint32_t arg, ...)
+{
+	(void)argc;
+	(void)arg;
+    g_uartlab_callback_count++;
+    g_uartlab_evidence[0] = ipsr();
+    g_uartlab_evidence[1] = getreg32(0xe000e304);
+    g_uartlab_evidence[2] = current_regs[REG_EXC_RETURN];
+    g_uartlab_evidence[3] = current_regs[REG_PC];
+    g_uartlab_evidence[4] = current_regs[REG_XPSR];
+    sem_post(&g_gate);
+    g_uartlab_evidence[5] = current_regs[REG_EXC_RETURN];
+}
+
+static int b_main(int argc, char **argv)
+{
+    struct tcb_s *a;
+    sem_wait(&g_gate);
+    g_uartlab_stage = 3;
+    a = sched_gettcb(g_a_pid);
+    g_uartlab_evidence[6] = ipsr();
+    g_uartlab_evidence[7] = getreg32(0xe000e304);
+    g_uartlab_evidence[8] = a ? a->xcp.regs[REG_EXC_RETURN] : 0;
+    g_uartlab_evidence[9] = a ? a->xcp.regs[REG_PC] : 0;
+    g_uartlab_evidence[10] = a ? a->xcp.regs[REG_XPSR] : 0;
+    g_uartlab_evidence[11] = g_a_pid;
+    g_uartlab_evidence[12] = getpid();
+    uartlab_observe();
+    if (g_uartlab_mode != 3) {
+        g_uartlab_evidence[13] = task_delete(g_a_pid);
+    } else {
+        g_uartlab_evidence[13] = 0xfeed;
+    }
+    g_uartlab_evidence[14] = sched_gettcb(g_a_pid) != NULL;
+    g_uartlab_evidence[15] = getreg32(0xe000e304);
+    g_uartlab_stage = 4;
+    /* Resume ordinary TIMER0 generation. Only the controlled interval was paused. */
+    putreg32(MPS2_TIMER_CTRL_EN | MPS2_TIMER_CTRL_IRQEN, MPS2_TIMER0_CTRL);
+    uartlab_after_kill();
+    for (;;) {
+        __asm__ volatile("nop");
+    }
+    return 0;
+}
+
+static int a_main(int argc, char **argv)
+{
+    irqstate_t flags;
+    g_a_pid = getpid();
+    flags = irqsave();
+    putreg32(0, MPS2_TIMER0_CTRL);
+    putreg32(MPS2_TIMER_INTSTATUS_IRQ, MPS2_TIMER0_INTSTATUS);
+    putreg32(1u << 3, 0xe000e280); /* clear pre-existing TIMER0 pending */
+    up_prioritize_irq(MPS2_IRQ_TIMER0, g_uartlab_priority);
+    wd_start(g_watchdog, 1, wake_b, 0);
+    g_uartlab_stage = 2;
+    g_uartlab_armed = 1;
+    irqrestore(flags);
+    uartlab_ready();
+    for (;;) {
+        __asm__ volatile("nop");
+    }
+    return 0;
+}
+
+static int command(int argc, char **argv)
+{
+    if (g_uartlab_stage || argc < 3) return -1;
+    g_uartlab_mode = strtoul(argv[1], NULL, 0); /* 0: epilogue, 1: body, 3: no kill */
+    g_uartlab_priority = strtoul(argv[2], NULL, 0);
+    sem_init(&g_gate, 0, 0);
+    g_watchdog = wd_create();
+    if (!g_watchdog) return -1;
+    g_uartlab_stage = 1;
+    g_b_pid = task_create("uartlab_B", 140, 4096, b_main, NULL);
+    if (g_b_pid < 0) return -1;
+    return task_create("uartlab_A", 130, 4096, a_main, NULL) < 0 ? -1 : 0;
+}
+
+void uartlab_initialize(void)
+{
+    tash_cmd_install("uartrace", command, TASH_EXECMD_SYNC);
+}
diff --git a/tools/uart-active-repro/reproduce.py b/tools/uart-active-repro/reproduce.py
new file mode 100644
index 000000000..237942db7
--- /dev/null
+++ b/tools/uart-active-repro/reproduce.py
@@ -0,0 +1,143 @@
+#!/usr/bin/env python3
+"""Run real TizenRT UART/TIMER/task_delete paths, with read-only GDB probes."""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import select
+import socket
+import struct
+import subprocess
+import tempfile
+import time
+from datetime import datetime, timezone
+from rsp import Elf, Remote
+
+def run(args):
+    out = args.out.resolve()
+    out.mkdir(parents=True, exist_ok=False)
+    elf = Elf(args.elf)
+    result = dict(started_at=datetime.now(timezone.utc).isoformat(), mode=args.mode,
+                  priority=hex(args.priority), elf_sha256=hashlib.sha256(args.elf.read_bytes()).hexdigest(),
+                  qemu_version=subprocess.check_output([args.qemu, '--version'], text=True).splitlines()[0],
+                  debugger_target_writes=False, events=[], outcome='inconclusive')
+    proc = conn = None
+    try:
+        with tempfile.TemporaryDirectory(prefix='uart-active-', dir='/private/tmp') as tmp, \
+             (out/'serial.log').open('wb') as serial, (out/'stderr.log').open('wb') as stderr, \
+             (out/'rsp.log').open('w') as trace:
+            sock = str(Path(tmp)/'gdb.sock')
+            cmd = [args.qemu, '-M', 'mps2-an505', '-kernel', str(args.elf.resolve()),
+                   '-display', 'none', '-monitor', 'none', '-serial', 'stdio', '-nic', 'none',
+                   '-S', '-gdb', f'unix:{sock},server=on,wait=off',
+                   '-d', 'int,guest_errors', '-D', str(out/'exceptions.log')]
+            result['command'] = cmd
+            proc = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=serial, stderr=stderr)
+            deadline = time.monotonic() + 30
+            while not Path(sock).exists():
+                if proc.poll() is not None or time.monotonic() > deadline:
+                    raise RuntimeError('QEMU startup failed')
+                time.sleep(.02)
+            conn = socket.socket(socket.AF_UNIX)
+            conn.settimeout(5)
+            conn.connect(sock)
+            remote = Remote(conn, trace)
+            remote.request('?')
+            remote.discover_registers()
+            points = {elf.address(n): n for n in ['uartlab_ready', 'uartlab_injected',
+                      'uartlab_observe', 'uartlab_after_kill', 'up_assert',
+                      'up_hardfault', 'up_usagefault', 'up_memfault', 'up_busfault']}
+            for addr in points:
+                remote.breakpoint(addr)
+
+            def snapshot(kind):
+                regs = remote.registers()
+                data = dict(kind=kind, registers={k:hex(v) for k,v in regs.items()},
+                            pc_symbol=elf.symbol(regs['pc']),
+                            counters={n:remote.word(elf.address(n)) for n in [
+                                'g_uartlab_stage', 'g_uartlab_rx_count', 'g_uartlab_timer_count',
+                                'g_uartlab_callback_count', 'g_uartlab_armed']},
+                            current_regs=hex(remote.word(elf.address('current_regs'))),
+                            hardware={n:hex(remote.word(a)) for n,a in {
+                                'iabr0':0xe000e300, 'iabr1':0xe000e304, 'ispr0':0xe000e200,
+                                'ispr1':0xe000e204,
+                                'iser1':0xe000e104, 'icsr':0xe000ed04, 'ccr':0xe000ed14,
+                                'cfsr':0xe000ed28, 'hfsr':0xe000ed2c,
+                                'uart_state':0x40200004, 'uart_ctrl':0x40200008,
+                                'uart_intstatus':0x4020000c}.items()},
+                            evidence=[hex(x) for x in struct.unpack('<24I', remote.memory(
+                                elf.address('g_uartlab_evidence'), 96))])
+                if 'g_nestlevel' in elf.symbols:
+                    data['nestlevel'] = remote.word(elf.address('g_nestlevel'))
+                result['events'].append(data)
+                return data
+
+            remote.send('c')
+            while b'TASH>>' not in (out/'serial.log').read_bytes():
+                if proc.poll() is not None or time.monotonic() > deadline:
+                    raise RuntimeError('fresh TASH not reached')
+                if select.select([conn], [], [], .02)[0]:
+                    remote.packet()
+                    snapshot('unexpected_boot_stop')
+                    raise RuntimeError('boot fault')
+            proc.stdin.write(f'uartrace {args.mode} {args.priority}\n'.encode())
+            proc.stdin.flush()
+            while time.monotonic() < deadline:
+                if proc.poll() is not None:
+                    raise RuntimeError('QEMU exited')
+                if not select.select([conn], [], [], .05)[0]:
+                    continue
+                stop = remote.packet()
+                regs = remote.registers()
+                name = points.get(regs['pc'], 'unknown_stop')
+                event = snapshot(name)
+                if name.startswith('up_') or name == 'unknown_stop':
+                    raise RuntimeError('guest fault: '+name)
+                remote.breakpoint(regs['pc'], False)
+                if name == 'uartlab_after_kill':
+                    before = event['counters']['g_uartlab_rx_count']
+                    remote.send('c')
+                    proc.stdin.write(b'?'); proc.stdin.flush()
+                    time.sleep(.15)
+                    remote.interrupt()
+                    follow = snapshot('after_second_rx')
+                    active = int(follow['hardware']['iabr1'],16) & 1
+                    rxfull = int(follow['hardware']['uart_state'],16) & 2
+                    unchanged = follow['counters']['g_uartlab_rx_count'] == before
+                    if active and rxfull and unchanged:
+                        result['outcome'] = 'uart_active_stuck'
+                    elif not active and not rxfull and not unchanged:
+                        result['outcome'] = 'uart_operational'
+                    else:
+                        result['outcome'] = 'unexpected_uart_state'
+                    break
+                remote.send('c')
+                if name == 'uartlab_ready':
+                    # TIMER1 keeps counting while A spins; a real watchdog tick is due.
+                    time.sleep(.12)
+                    proc.stdin.write(b'!'); proc.stdin.flush()
+            else:
+                remote.interrupt()
+                snapshot('timeout')
+                raise RuntimeError('timeout before B completed task_delete')
+    except Exception as exc:
+        result['error'] = str(exc)
+    finally:
+        if conn:
+            conn.close()
+        if proc and proc.poll() is None:
+            proc.terminate()
+            try: proc.wait(timeout=3)
+            except subprocess.TimeoutExpired: proc.kill(); proc.wait()
+        (out/'result.json').write_text(json.dumps(result, indent=2)+'\n')
+    print(json.dumps(dict(out=str(out), outcome=result['outcome'], error=result.get('error'))))
+    return 0 if result['outcome'] in ('uart_active_stuck','uart_operational') else 1
+
+if __name__ == '__main__':
+    p=argparse.ArgumentParser()
+    p.add_argument('--elf', type=Path, default=Path('build/output/bin/tinyara'))
+    p.add_argument('--out', type=Path, required=True)
+    p.add_argument('--mode', type=int, default=0)
+    p.add_argument('--priority', type=lambda x:int(x,0), default=0x40)
+    p.add_argument('--qemu', default='qemu-system-arm')
+    raise SystemExit(run(p.parse_args()))
diff --git a/tools/uart-active-repro/rsp.py b/tools/uart-active-repro/rsp.py
new file mode 100644
index 000000000..158bab004
--- /dev/null
+++ b/tools/uart-active-repro/rsp.py
@@ -0,0 +1,159 @@
+#!/usr/bin/env python3
+"""Reproduce three distinct fault-stop outcomes on a freshly booted TizenRT ELF.
+
+Only hardware breakpoints and reads are sent over GDB RSP. Fault injections
+are explicit, opt-in guest code. A timeout alone never constitutes a pass.
+"""
+import argparse
+from datetime import datetime, timezone
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import select
+import shutil
+import socket
+import struct
+import subprocess
+import tempfile
+import time
+import xml.etree.ElementTree as ET
+
+
+class Elf:
+    def __init__(self, path):
+        self.data = path.read_bytes()
+        assert self.data[:6] == b'\x7fELF\x01\x01', 'Expected ELF32 little endian'
+        hdr = struct.unpack_from('<16sHHIIIIIHHHHHH', self.data)
+        sections = [struct.unpack_from('<10I', self.data, hdr[6] + i * hdr[11])
+                    for i in range(hdr[12])]
+        self.symbols = {}
+        for sh in sections:
+            if sh[1] != 2:
+                continue
+            st = sections[sh[6]]
+            strings = self.data[st[4]:st[4]+st[5]]
+            for off in range(sh[4], sh[4]+sh[5], sh[9]):
+                name, addr, size, info, other, index = struct.unpack_from('<IIIBBH', self.data, off)
+                name = strings[name:].split(b'\0', 1)[0].decode()
+                if name and index:
+                    self.symbols[name] = {'address': addr & ~1 if info & 15 == 2 else addr,
+                                          'size': size, 'function': info & 15 == 2}
+        self.functions = [(v['address'], v['size'], k) for k, v in self.symbols.items() if v['function']]
+
+    def address(self, name):
+        return self.symbols[name]['address']
+
+    def symbol(self, address):
+        matches = [(a, n) for a, size, n in self.functions if a <= address < a + size]
+        return f'{max(matches)[1]}+0x{address-max(matches)[0]:x}' if matches else hex(address)
+
+
+class Remote:
+    def __init__(self, conn, trace):
+        self.conn, self.trace = conn, trace
+        self.regs = {}
+
+    def packet(self):
+        while True:
+            ch = self.conn.recv(1)
+            if not ch:
+                raise EOFError('debugger disconnected')
+            if ch == b'$':
+                break
+        raw = bytearray()
+        while True:
+            ch = self.conn.recv(1)
+            if not ch:
+                raise EOFError('debugger disconnected')
+            if ch == b'#':
+                break
+            raw += ch
+        checksum = b''
+        while len(checksum) < 2:
+            checksum += self.conn.recv(2-len(checksum))
+        assert int(checksum, 16) == sum(raw) & 255
+        self.conn.sendall(b'+')
+        data = bytearray()
+        i = 0
+        while i < len(raw):
+            if raw[i] == ord('*'):
+                i += 1
+                data.extend(bytes([data[-1]]) * (raw[i]-29))
+            elif raw[i] == ord('}'):
+                i += 1
+                data.append(raw[i] ^ 32)
+            else:
+                data.append(raw[i])
+            i += 1
+        result = data.decode()
+        self.trace.write('< ' + result + '\n'); self.trace.flush()
+        return result
+
+    def send(self, request):
+        raw = request.encode()
+        self.trace.write('> ' + request + '\n'); self.trace.flush()
+        self.conn.sendall(b'$' + raw + b'#' + f'{sum(raw)&255:02x}'.encode())
+        assert self.conn.recv(1) == b'+'
+
+    def request(self, request):
+        self.send(request)
+        return self.packet()
+
+    def xml(self, annex):
+        offset, text = 0, ''
+        while True:
+            reply = self.request(f'qXfer:features:read:{annex}:{offset:x},800')
+            assert reply[0] in 'ml', reply
+            text += reply[1:]
+            if reply[0] == 'l':
+                # QEMU's GDB XML uses xi:include without a namespace declaration.
+                return ET.fromstring(text.replace('xi:include', 'include'))
+            offset += len(reply[1:].encode())
+
+    def discover_registers(self):
+        number = 0
+        def walk(tree):
+            nonlocal number
+            for node in tree:
+                if node.tag.endswith('include'):
+                    walk(self.xml(node.attrib['href']))
+                elif node.tag == 'reg':
+                    number = int(node.get('regnum', number))
+                    self.regs[node.get('name').lower()] = number
+                    number += 1
+                else:
+                    walk(node)
+        walk(self.xml('target.xml'))
+
+    def memory(self, addr, size):
+        reply = self.request(f'm{addr:x},{size:x}')
+        if reply.startswith('E'):
+            raise RuntimeError(f'memory {addr:#x}: {reply}')
+        result = bytes.fromhex(reply)
+        assert len(result) == size
+        return result
+
+    def word(self, addr):
+        return int.from_bytes(self.memory(addr, 4), 'little')
+
+    def registers(self):
+        result = {}
+        wanted = {'r0', 'r1', 'r2', 'r3', 'sp', 'lr', 'pc', 'xpsr', 'msp', 'psp',
+                  'primask', 'basepri', 'faultmask', 'control', 'msp_ns', 'psp_ns',
+                  'msp_s', 'psp_s', 'msplim', 'psplim'}
+        for name, number in self.regs.items():
+            if name in wanted:
+                reply = self.request(f'p{number:x}')
+                if reply and not reply.startswith('E') and 'x' not in reply:
+                    result[name] = int.from_bytes(bytes.fromhex(reply), 'little')
+        return result
+
+    def breakpoint(self, addr, enabled=True):
+        assert self.request(f'{"Z" if enabled else "z"}1,{addr:x},2') == 'OK'
+
+    def interrupt(self):
+        self.trace.write('> INTERRUPT\n'); self.trace.flush()
+        self.conn.sendall(b'\x03')
+        return self.packet()
