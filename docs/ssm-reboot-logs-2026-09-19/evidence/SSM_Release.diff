+++ b/DA-Service/SSM/src/SSM_file_helper.c
@@ -0,0 +1,229 @@
+#include "SSM_file_helper.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <sys/stat.h>
+#include <errno.h>
+#include <dawit_common.h>
+#include <dawit_log.h>
+
+#define MAX_FILE_NAME_SIZE 64
+
+// SSM file open function
+dawit_result SSM_file_open(ssm_file **file, char *file_name, char *open_mode)
+{
+	if (file_name == NULL || open_mode == NULL || file == NULL)
+	{
+		DAWIT_LOG_ERROR(DAWIT_TAG_SSM, "Invalid arguments: file=[%p], file_name=[%p], open_mode=[%p]", file, file_name, open_mode);
+		return DAWIT_INVALID_ARGS;
+	}
+
+	*file = fopen(file_name, open_mode);
+	if (*file == NULL)
+	{
+		DAWIT_LOG_ERROR(DAWIT_TAG_SSM, "Failed to open file [%s] with mode [%s], errno=%d (%s)", file_name, open_mode, errno, strerror(errno));
+		return DAWIT_FAIL;
+	}
+
+	DAWIT_LOG_DEBUG(DAWIT_TAG_SSM, "Successfully opened file [%s] with mode [%s]", file_name, open_mode);
+	return DAWIT_SUCCESS;
+}
+
+// SSM file close function
+dawit_result SSM_file_close(ssm_file *file)
+{
+	if (file == NULL)
+	{
+		DAWIT_LOG_ERROR(DAWIT_TAG_SSM, "Invalid argument: file=[%p]", file);
+		return DAWIT_INVALID_ARGS;
+	}
+
+	if (fclose(file) != 0)
+	{
+		DAWIT_LOG_ERROR(DAWIT_TAG_SSM, "Failed to close file, errno=%d (%s)", errno, strerror(errno));
+		return DAWIT_FAIL;
+	}
+
+	DAWIT_LOG_DEBUG(DAWIT_TAG_SSM, "Successfully closed file");
+	return DAWIT_SUCCESS;
+}
+
+// SSM file read function
+dawit_result SSM_file_read(ssm_file *file, unsigned char *buffer, unsigned int read_size)
+{
+	int read_count = 0;
+
+	if (file == NULL || buffer == NULL)
+	{
+		DAWIT_LOG_ERROR(DAWIT_TAG_SSM, "Invalid arguments: file=[%p], buffer=[%p]", file, buffer);
+		return DAWIT_INVALID_ARGS;
+	}
+
+	read_count = fread(buffer, 1, read_size, file);
+
+	if (read_count != read_size)
+	{
+		if (feof(file))
+		{
+			DAWIT_LOG_DEBUG(DAWIT_TAG_SSM, "Reached end of file");
+		}
+		else
+		{
+			DAWIT_LOG_ERROR(DAWIT_TAG_SSM, "Failed to read file: expected [%u] bytes, read [%d] bytes, errno=%d (%s)", read_size, read_count, errno, strerror(errno));
+		}
+		return DAWIT_FAIL;
+	}
+
+	return DAWIT_SUCCESS;
+}
+
+
+// SSM file write function
+dawit_result SSM_file_write(ssm_file *file, unsigned char *data, unsigned int write_size)
+{
+	int writed_count = 0;
+
+	if (file == NULL || data == NULL)
+	{
+		DAWIT_LOG_ERROR(DAWIT_TAG_SSM, "Invalid arguments: file=[%p], data=[%p]", file, data);
+		return DAWIT_INVALID_ARGS;
+	}
+
+	writed_count = fwrite(data, 1, write_size, file);
+	if (writed_count != write_size)
+	{
+		DAWIT_LOG_ERROR(DAWIT_TAG_SSM, "Failed to write file: expected [%u] bytes, wrote [%d] bytes, errno=%d (%s)", write_size, writed_count, errno, strerror(errno));
+		return DAWIT_FAIL;
+	}
+	return DAWIT_SUCCESS;
+}
+
+// SSM file seek function
+dawit_result SSM_file_seek(ssm_file *file, long offset, int whence)
+{
+	if (file == NULL)
+	{
+		DAWIT_LOG_ERROR(DAWIT_TAG_SSM, "Invalid argument: file=[%p]", file);
+		return DAWIT_INVALID_ARGS;
+	}
+
+	if (fseek(file, offset, whence) != 0)
+	{
+		DAWIT_LOG_ERROR(DAWIT_TAG_SSM, "Failed to seek file: offset=[%ld], whence=[%d], errno=%d (%s)", offset, whence, errno, strerror(errno));
+		return DAWIT_FAIL;
+	}
+
+	return DAWIT_SUCCESS;
+}
+
+// SSM file get size function
+dawit_result SSM_file_get_size(ssm_file *file, unsigned int *file_size)
+{
+	int offset;
+	int retval;
+	int org_offset;
+
+	if (file == NULL || file_size == NULL)
+	{
+		DAWIT_LOG_ERROR(DAWIT_TAG_SSM, "Invalid arguments: file=[%p], file_size=[%p]", file, file_size);
+		return DAWIT_INVALID_ARGS;
+	}
+
+	org_offset = ftell(file);
+	if (org_offset == -1)
+	{
+		DAWIT_LOG_ERROR(DAWIT_TAG_SSM, "Failed to get current file position, errno=%d (%s)", errno, strerror(errno));
+		return DAWIT_FAIL;
+	}
+
+	retval = fseek(file, 0, SEEK_END);
+	if (retval != 0)
+	{
+		DAWIT_LOG_ERROR(DAWIT_TAG_SSM, "Failed to seek to end of file, errno=%d (%s)", errno, strerror(errno));
+		return DAWIT_FAIL;
+	}
+
+	offset = ftell(file);
+	if (offset == -1)
+	{
+		DAWIT_LOG_ERROR(DAWIT_TAG_SSM, "Failed to get file size, errno=%d (%s)", errno, strerror(errno));
+		return DAWIT_FAIL;
+	}
+
+	if (fseek(file, org_offset, SEEK_SET) != 0)
+	{
+		DAWIT_LOG_ERROR(DAWIT_TAG_SSM, "Failed to restore file position, errno=%d (%s)", errno, strerror(errno));
+		return DAWIT_FAIL;
+	}
+
+	*file_size = offset;
+	return DAWIT_SUCCESS;
+}
+
+// SSM file is exist function
+dawit_result SSM_file_is_exist(char *file_name)
+{
+	struct stat st;
+
+	if (file_name == NULL)
+	{
+		DAWIT_LOG_ERROR(DAWIT_TAG_SSM, "Invalid argument: file_name=[%p]", file_name);
+		return DAWIT_INVALID_ARGS;
+	}
+
+	int ret = stat(file_name, &st);
+	if ((ret != 0) && (errno == ENOENT))
+	{
+		DAWIT_LOG_INFO(DAWIT_TAG_SSM, "File [%s] does not exist", file_name);
+		return DAWIT_FAIL;
+	}
+
+	DAWIT_LOG_DEBUG(DAWIT_TAG_SSM, "File [%s] exists", file_name);
+	return DAWIT_SUCCESS;
+}
+
+// SSM file delete function
+dawit_result SSM_file_delete(char *file_name)
+{
+	if (file_name == NULL)
+	{
+		DAWIT_LOG_ERROR(DAWIT_TAG_SSM, "Invalid argument: file_name=[%p]", file_name);
+		return DAWIT_INVALID_ARGS;
+	}
+
+	if (unlink(file_name) != 0)
+	{
+		DAWIT_LOG_ERROR(DAWIT_TAG_SSM, "Failed to delete file [%s], errno=%d (%s)", file_name, errno, strerror(errno));
+		return DAWIT_FAIL;
+	}
+
+	DAWIT_LOG_INFO(DAWIT_TAG_SSM, "Successfully deleted file [%s]", file_name);
+	return DAWIT_SUCCESS;
+}
+
+// SSM rename file function
+dawit_result SSM_rename_file(const char *old_path, const char *new_path)
+{
+	char src_path[MAX_FILE_NAME_SIZE] = {0,};
+	char dst_path[MAX_FILE_NAME_SIZE] = {0,};
+
+	if (old_path == NULL || new_path == NULL)
+	{
+		DAWIT_LOG_ERROR(DAWIT_TAG_SSM, "Invalid arguments: old_path=[%p], new_path=[%p]", old_path, new_path);
+		return DAWIT_INVALID_ARGS;
+	}
+
+	snprintf(src_path, MAX_FILE_NAME_SIZE, "%s", old_path);
+	snprintf(dst_path, MAX_FILE_NAME_SIZE, "%s", new_path);
+
+	if (rename(src_path, dst_path) != 0)
+	{
+		DAWIT_LOG_ERROR(DAWIT_TAG_SSM, "Failed to rename file from [%s] to [%s], errno=%d (%s)",
+						src_path, dst_path, errno, strerror(errno));
+		return DAWIT_FAIL;
+	}
+
+	DAWIT_LOG_DEBUG(DAWIT_TAG_SSM, "Successfully renamed file from [%s] to [%s]", src_path, dst_path);
+	return DAWIT_SUCCESS;
+}
\ No newline at end of file
