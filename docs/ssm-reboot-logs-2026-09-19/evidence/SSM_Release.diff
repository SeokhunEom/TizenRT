+static void setup_log_data(void)
+{
+    SSM_ES_init_table();
+    SSM_SYS_init_table();
+    
+    LOG_BUFFER_ADD_INFO("CS001", "Test message with message");  
+    LOG_BUFFER_ADD_INFO("ES001", NULL);
+    LOG_BUFFER_ADD_ERROR("NS001", "Error message");
+    LOG_BUFFER_ADD_ERROR("AS001", NULL);
+    LOG_BUFFER_ADD_DEBUG("SS001", "Debug message");
+    LOG_BUFFER_ADD_DEBUG("PS001", NULL);
+    LOG_BUFFER_ADD_INFO("RR001", "RR type message");
+    log_buffer_add_KPI_str(KPI_TAG_SYSTEM, "origin_time_zone", "Asia/Seoul", KPI_SEND_EVERY);
+    log_buffer_add_KPI_num(KPI_TAG_SYSTEM, "hello", 1, KPI_SEND_EVERY);
+}
+
+static void teardown_log_data(void)
+{
+    /* Log buffer and KPI buffer cleanup is handled internally */
+}
