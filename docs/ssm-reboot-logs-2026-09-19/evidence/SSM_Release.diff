+} ssm_file_write_timeout_context;
+
+static ssm_file_write_timeout_context g_ssm_file_write_context;
+static const char* KPI_DATA_TYPE_STR[] = { [KPI_DATA_NUM] = "NUM", [KPI_DATA_STR] = "STR" };
+static kpi_file_data kpi_file_table[KPI_BUFFER_SIZE];
+static unsigned int kpi_file_count = 0;
+static bool g_ssm_is_file_write_api_done = false;
+static bool g_ssm_file_write_timeout = false;
+static dawit_mutex g_ssm_file_write_timeout_mutex = DAWIT_MUTEX_INITIALIZER;
+
+static void SSM_set_file_write_timeout(bool value);
+static bool SSM_get_file_write_timeout(void);
+
+static const char* kpi_data_type_to_string(KPI_DATA_TYPE type);
+static dawit_result SSM_write_ES_logs_to_file(ssm_file *file);
+static dawit_result SSM_write_SYS_logs_to_file(ssm_file *file);
+static dawit_result SSM_write_logs_to_file(void);
+static void SSM_skip_to_next_line(ssm_file *file);
+static log_data* SSM_read_ES_log_from_file(ssm_file *file, bool *is_eof);
+static void SSM_append_log_to_list(log_data **head, log_data **tail, log_data *new_node);
+static log_data* SSM_read_ES_logs_batch(ssm_file *file, bool *is_eof);
+static int SSM_read_and_restore_SYS_log(ssm_file *file, bool *is_eof);
+static int SSM_restore_SYS_logs_batch(ssm_file *file, bool *is_eof);
+static dawit_result SSM_restore_and_send_ES_logs(log_data *head);
+static void SSM_free_log_data_list(log_data *head);
+static SSM_Log_Type SSM_map_code_to_log_type(char code);
+static dawit_result SSM_get_file_creation_time_imp(const char *file_path, time_t *creation_time);
+static void SSM_free_sys_kpi_table(void);
+
+static const char* kpi_data_type_to_string(KPI_DATA_TYPE type)
+{
+	if (type < 0 || type > KPI_DATA_STR)
+	{
+		return "UNKNOWN";
+	}
+	
+	return KPI_DATA_TYPE_STR[type] ;
+}
+
+static void SSM_set_file_write_timeout(bool value)
+{
+	dawit_mutex_acquire(&g_ssm_file_write_timeout_mutex, DAWIT_FOREVER);
+	g_ssm_file_write_timeout = value;
+	dawit_mutex_release(&g_ssm_file_write_timeout_mutex);
+}
+
+static bool SSM_get_file_write_timeout(void)
+{
+	bool value;
+	dawit_mutex_acquire(&g_ssm_file_write_timeout_mutex, DAWIT_FOREVER);
+	value = g_ssm_file_write_timeout;
+	dawit_mutex_release(&g_ssm_file_write_timeout_mutex);
+	return value;
+}
