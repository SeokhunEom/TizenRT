diff --git a/test/utc/SSM_file_logger_test.c b/test/utc/SSM_file_logger_test.c
new file mode 100644
index 0000000..1d99706
--- /dev/null
+++ b/test/utc/SSM_file_logger_test.c
@@ -0,0 +1,366 @@
+#include <check.h>
+#include <stdlib.h>
+#include <stdio.h>
+#include <string.h>
+#include <time.h>
+#include <unistd.h>
+#include <stdarg.h>
+#include <pthread.h>
+
+#include "DA-Service/SSM/include/SSM_file_logger.h"
+#include "DA-Service/SSM/include/SSM_client_ES.h"
+#include "DA-Service/SSM/include/SSM_client_SYS.h"
+#include "DA-Service/SSM/include/SSM_client.h"
+#include "log_buffer.h"
+#include "kpi_buffer.h"
+#include "json/cJSON.h"
+
+#define TEST_LOG_FILE "/mnt/test_ssm_stored_logs"
+
+#define MOCK_LOG_BUFFER_SIZE 100
+
+typedef struct mock_log_data {
+	int time;
+	char code[LOG_BUFFER_CODE_SIZE];
+	char *message;
+	int level;
+	struct mock_log_data *pre;
+	struct mock_log_data *next;
+} mock_log_data_t;
+
+static mock_log_data_t mock_log_buffer_table[MOCK_LOG_BUFFER_SIZE];
+static mock_log_data_t *mock_first_log = NULL;
+static int mock_first_log_index = -1;
+static mock_log_data_t *mock_last_log = NULL;
+static int mock_last_log_index = -1;
+static int mock_base_time = 0;
+static pthread_mutex_t mock_log_lock = PTHREAD_MUTEX_INITIALIZER;
+
+void __wrap_log_buffer_lock(void)
+{
+	pthread_mutex_lock(&mock_log_lock);
+}
+
+void __wrap_log_buffer_unlock(void)
+{
+	pthread_mutex_unlock(&mock_log_lock);
+}
+
+void __wrap_log_buffer_init(int time_system_init)
+{
+	mock_base_time = time_system_init;
+}
+
+int __wrap_log_buffer_add_log(char *code, int level, const char *message_format, ...)
+{
+	int index;
+	char *message = NULL;
+	
+	if (code == NULL)
+	{
+		return -1;
+	}
+
+	if (message_format != NULL)
+	{
+		va_list message_args;
+		va_start(message_args, message_format);
+		vasprintf(&message, message_format, message_args);
+		va_end(message_args);
+	}
+
+	pthread_mutex_lock(&mock_log_lock);
+
+	index = (mock_last_log_index + 1) % MOCK_LOG_BUFFER_SIZE;
+	if (index == mock_first_log_index)
+	{
+		if (mock_log_buffer_table[mock_first_log_index].message != NULL)
+		{
+			free(mock_log_buffer_table[mock_first_log_index].message);
+			mock_log_buffer_table[mock_first_log_index].message = NULL;
+		}
+		mock_first_log_index = (mock_first_log_index + 1) % MOCK_LOG_BUFFER_SIZE;
+		mock_first_log = &mock_log_buffer_table[mock_first_log_index];
+		mock_log_buffer_table[mock_first_log_index].pre = NULL;
+	}
+
+	if (mock_first_log_index == -1)
+	{
+		mock_first_log_index = 0;
+		mock_first_log = &mock_log_buffer_table[mock_first_log_index];
+		mock_log_buffer_table[mock_first_log_index].pre = NULL;
+		mock_log_buffer_table[mock_first_log_index].next = NULL;
+	}
+	else
+	{
+		mock_log_buffer_table[index].pre = &mock_log_buffer_table[mock_last_log_index];
+		mock_log_buffer_table[mock_last_log_index].next = &mock_log_buffer_table[index];
+	}
+
+	mock_log_buffer_table[index].time = (int)time(NULL);
+	snprintf(mock_log_buffer_table[index].code, LOG_BUFFER_CODE_SIZE, "%s", code);
+	mock_log_buffer_table[index].message = message;
+	mock_log_buffer_table[index].next = NULL;
+	mock_log_buffer_table[index].level = level;
+
+	mock_last_log_index = index;
+	mock_last_log = &mock_log_buffer_table[mock_last_log_index];
+
+	pthread_mutex_unlock(&mock_log_lock);
+
+	return 0;
+}
+
+log_data *__wrap_log_buffer_get_first(void)
+{
+	return (log_data *)mock_first_log;
+}
+
+log_data *__wrap_log_buffer_get_last(void)
+{
+	return (log_data *)mock_last_log;
+}
+
+void __wrap_log_buffer_clear(void)
+{
+	mock_first_log = NULL;
+	mock_first_log_index = -1;
+	mock_last_log = NULL;
+	mock_last_log_index = -1;
+	mock_base_time = 0;
+}
+
+dawit_result __wrap_SSM_is_policy_done(void)
+{
+	return DAWIT_TRUE;
+}
+
+struct tm* __wrap_gmtime(const time_t *timep)
+{
+    static struct tm tm;
+    (void)timep;
+    tm.tm_year = 121;
+    tm.tm_mon = 0;
+    tm.tm_mday = 1;
+    tm.tm_hour = 12;
+    tm.tm_min = 0;
+    tm.tm_sec = 0;
+    tm.tm_isdst = 0;
+    return &tm;
+}
