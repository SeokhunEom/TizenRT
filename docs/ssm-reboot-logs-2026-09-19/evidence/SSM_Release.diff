+static ssm_cmd_result ssm_command_store(int argc, char *argv[])
+{
+    dawit_result result = DAWIT_SUCCESS;
+    unsigned int time_limit_ms = 0;
+    
+    if (argc != 3)
+    {
+        return SSM_COMMAND_INVALID_CMDS;
+    }
+
+	time_limit_ms = (unsigned int)atoi(argv[2]);
+	if (time_limit_ms == 0)
+	{
+		DAWIT_LOG_ERROR(DAWIT_TAG_SSM, "Invalid time limit value: %s", argv[2]);
+		return SSM_COMMAND_INVALID_ARGS;
+	}
+	DAWIT_LOG_INFO(DAWIT_TAG_SSM, "Storing logs with time limit: %u ms", time_limit_ms);
+
+	result = SSM_Store_logs_to_file(time_limit_ms);
+
+
+    if (result == DAWIT_SUCCESS) {
+        DAWIT_LOG_INFO(DAWIT_TAG_SSM, "✓ Logs saved to file");
+    } else if (result == DAWIT_TIMEOUT) {
+        DAWIT_LOG_INFO(DAWIT_TAG_SSM, "⚠ Log save timed out (proceeding with reboot)");
+    } else {
+        DAWIT_LOG_INFO(DAWIT_TAG_SSM, "✗ Log save failed (proceeding with reboot)");
+    }
+    DAWIT_LOG_INFO(DAWIT_TAG_SSM, "Rebooting now...");
+    exit(0);
+
+
+	DAWIT_LOG_INFO(DAWIT_TAG_SSM, "Successfully stored logs and KPI data to ssm_stored_logs file");
+
+    return SSM_COMMAND_SUCCESS;
+}
