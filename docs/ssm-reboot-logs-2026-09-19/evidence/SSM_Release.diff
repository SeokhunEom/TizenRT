+/* Set ES event data from a log_data linked list (read from file) into cJSON event array.
+ * Iterates through up to 20 log_data nodes and adds each as an event entry. */
+static void SSM_ES_set_event_from_list(log_data *head, cJSON *event)
+{
+	log_data *current = head;
+	int seqno = SSM_ES_get_seq_no();
+	int count = 0;
+
+	while (current != NULL && count < 20)
+	{
+		time_t utc_time = (time_t)current->time;
+		char str_time[20] = { 0, };
+		char str_seqno[12] = { 0, };
+		cJSON *obj = NULL;
+		cJSON *kpi = NULL;
+
+		strftime(str_time, 20, "%Y-%m-%d %H:%M:%S", gmtime(&utc_time));
+		snprintf(str_seqno, 12, "%d", seqno);
+
+		cJSON_AddItemToArray(event, obj = cJSON_CreateObject());
+		cJSON_AddStringToObject(obj, "name", current->code);
+		cJSON_AddStringToObject(obj, "dt", str_time);
+		if (current->message != NULL)
+		{
+			cJSON_AddItemToObject(obj, "kpi", kpi = cJSON_CreateObject());
+			cJSON_AddStringToObject(kpi, "DebugInfo", current->message);
+		}
+		cJSON_AddStringToObject(obj, "seqno", str_seqno);
+
+		seqno++;
+		count++;
+		current = current->next;
+	}
+
+	g_file_last_send_seqno = seqno ;
+	DAWIT_LOG_INFO(DAWIT_TAG_SSM, "Set %d ES events from file list", count);
+}
+
+/* Send a pre-built cJSON root payload to server via mTLS.
+ * Handles TLS connection, write, and read with HOST_PC reconnection support. */
+static dawit_result SSM_Send_log_v2(cJSON *root_payload)
+{
+	dawit_tls tls = { NULL, };
+	dawit_tls_config tls_config = { NULL, };
+	dawit_result result = DAWIT_SUCCESS;
+	char* outh = NULL;
+	char *json_out = NULL;
+	int json_len = 0;
+	bool tls_locked = false;
+	bool tls_created = false;
+
+	if (root_payload == NULL)
+	{
+		DAWIT_LOG_ERROR(DAWIT_TAG_SSM, "SSM_Send_log_v2: root_payload is NULL");
+		return DAWIT_FAIL;
+	}
+
+	DAWIT_LOG_INFO(DAWIT_TAG_SSM, "SSM_Send_log_v2: Start sending log");
+
+	result = dawit_tls_lock();
+	if (result != DAWIT_SUCCESS)
+	{
+		DAWIT_LOG_ERROR(DAWIT_TAG_SSM, "dawit_tls_lock error code: %d!\n", result);
+		goto SSM_SEND_V2_FREE;
+	}
+	tls_locked = true;
+
+	result = dawit_tls_create(&tls);
+	if (result != DAWIT_SUCCESS)
+	{
+		DAWIT_LOG_ERROR(DAWIT_TAG_SSM, "dawit_tls_create error code: %d!\n", result);
+		goto SSM_SEND_V2_FREE;
+	}
+	tls_created = true;
+
+	SSM_external_tls_config_get_ocf(&tls_config, g_ssm_host, g_cli_cert);
+	result = dawit_tls_connect(&tls, &tls_config);
+	if (result != DAWIT_SUCCESS)
+	{
+		DAWIT_LOG_ERROR(DAWIT_TAG_SSM, "dawit_tls_connect error code: %d!\n", result);
+		goto SSM_SEND_V2_FREE;
+	}
+
+	outh = (char *)calloc(1, sizeof(char) * AUTHORIZATION_KEY_LEN + 1);
+	if (outh == NULL)
+	{
+		DAWIT_LOG_ERROR(DAWIT_TAG_SSM, "outh alloc fail !!! ");
+		result = DAWIT_FAIL;
+		goto SSM_SEND_V2_FREE;
+	}
+	make_Outh(outh);
+
+#ifdef HOST_PC
+	/* HOST_PC: Reconnect TLS to handle connection issues on host PC */
+	if (outh != NULL)
+	{
+		free(outh);
+		outh = NULL;
+	}
+	if (tls_created)
+	{
+		dawit_tls_destroy(&tls);
+		tls_created = false;
+	}
+	if (tls_locked)
+	{
+		dawit_tls_unlock();
+		tls_locked = false;
+	}
+
+	result = dawit_tls_lock();
+	if (result != DAWIT_SUCCESS)
+	{
+		DAWIT_LOG_ERROR(DAWIT_TAG_SSM, "dawit_tls_lock error code: %d!\n", result);
+		goto SSM_SEND_V2_FREE;
+	}
+	tls_locked = true;
+
+	result = dawit_tls_create(&tls);
+	if (result != DAWIT_SUCCESS)
+	{
+		DAWIT_LOG_ERROR(DAWIT_TAG_SSM, "dawit_tls_create error code: %d!\n", result);
+		goto SSM_SEND_V2_FREE;
+	}
+	tls_created = true;
+
+	SSM_external_tls_config_get_ocf(&tls_config, g_ssm_host, g_cli_cert);
+	result = dawit_tls_connect(&tls, &tls_config);
+	if (result != DAWIT_SUCCESS)
+	{
+		DAWIT_LOG_ERROR(DAWIT_TAG_SSM, "dawit_tls_connect error code: %d!\n", result);
+		goto SSM_SEND_V2_FREE;
+	}
+
+	outh = (char *)calloc(1, sizeof(char) * AUTHORIZATION_KEY_LEN + 1);
+	if (outh == NULL)
+	{
+		DAWIT_LOG_ERROR(DAWIT_TAG_SSM, "outh alloc fail !!! ");
+		result = DAWIT_FAIL;
+		goto SSM_SEND_V2_FREE;
+	}
+	make_Outh(outh);
+#endif
+
+	/* Print JSON payload to string */
+	json_out = cJSON_Print(root_payload);
+	if (json_out == NULL)
+	{
+		DAWIT_LOG_ERROR(DAWIT_TAG_SSM, "cJSON_Print failed");
+		result = DAWIT_FAIL;
+		goto SSM_SEND_V2_FREE;
+	}
+	json_len = strlen(json_out);
+
+	
+	/* Write to server */
+	result = SSM_Send_log_write(tls, outh, json_out, json_len);
+	if (result != DAWIT_SUCCESS)
+	{
+		DAWIT_LOG_ERROR(DAWIT_TAG_SSM, "SSM_Send_log_write failed");
+		goto SSM_SEND_V2_FREE;
+	}
+
+	/* Read response from server */
+	result = SSM_Send_log_read(tls, outh);
+	if (result != DAWIT_SUCCESS)
+	{
+		DAWIT_LOG_ERROR(DAWIT_TAG_SSM, "SSM_Send_log_read failed");
+	}
+	else
+	{
+		DAWIT_LOG_INFO(DAWIT_TAG_SSM, "SSM_Send_log_v2: SUCCESS");
+	}
+
+SSM_SEND_V2_FREE:
+	if (json_out != NULL)
+	{
+		free(json_out);
+		json_out = NULL;
+	}
+	if (outh != NULL)
+	{
+		free(outh);
+		outh = NULL;
+	}
+	if (tls_created)
+	{
+		dawit_tls_destroy(&tls);
+	}
+	if (tls_locked)
+	{
+		dawit_tls_unlock();
+	}
+
+	return result;
+}
+
+/* Send ES logs read from file (log_data linked list) directly to server via mTLS.
+ * Creates JSON from the log_data nodes and sends via TLS. */
+dawit_result SSM_Send_ES_logs_from_file(void *node)
+{
+	dawit_result result = DAWIT_SUCCESS;
+	cJSON *root = NULL;
+	cJSON *event = NULL;
+	log_data *head = (log_data *)node;
+
+	if (head == NULL)
+	{
+		DAWIT_LOG_WARNING(DAWIT_TAG_SSM, "node is NULL");
+		return DAWIT_FAIL;
+	}
+
+	DAWIT_LOG_INFO(DAWIT_TAG_SSM, "Start sending ES logs from list");
+
+	/* Build JSON: base request + eventlist from log_data nodes */
+	make_base_request(&root, SSM_EASYSETUP);
+	cJSON_AddItemToObject(root, "eventlist", event = cJSON_CreateArray());
+	SSM_ES_set_event_from_list(head, event);
+
+	/* Send via TLS */
+	result = SSM_Send_log_v2(root);
+	if(result == DAWIT_SUCCESS)
+	{
+		SSM_ES_update_seq_no(g_file_last_send_seqno);
+	}
+
+	/* Clean up the JSON root */
+	if (root != NULL)
+	{
+		cJSON_Delete(root);
+	}
+
+	return result;
+}
+
+
+static void SSM_SYS_set_event_from_table(kpi_file_data *kpi_data_array, unsigned int kpi_data_array_size ,cJSON *event)
+{
+
+	int seqno = 0;
+	int count = 0;
+	cJSON *kpi = NULL;
+	cJSON *obj = NULL;
+	char str_seqno[12] = { 0, };
+	char str_time[20] = { 0, };
+	time_t utc_time = 0; // file creation time
+
+    dawit_result time_result = SSM_get_file_creation_time(&utc_time);
+    if (time_result != DAWIT_SUCCESS) {
+        utc_time = time(NULL); // Use current time as fallback
+    }
+
+    strftime(str_time, sizeof(str_time), "%Y-%m-%d %H:%M:%S", gmtime(&utc_time));
+	
+	kpi = cJSON_CreateObject();
+
+	for (count = 0; count < kpi_data_array_size && count < KPI_BUFFER_SIZE; count++)
+	{
+
+		if (strncmp(kpi_data_array[count].data_type, "NUM", 3) == 0)
+		{
+			cJSON_AddNumberToObject(kpi, kpi_data_array[count].kpi_name, atoi(kpi_data_array[count].kpi_message));
+		}
+		else if (strncmp(kpi_data_array[count].data_type, "STR", 3) == 0)
+		{
+			cJSON_AddStringToObject(kpi, kpi_data_array[count].kpi_name, kpi_data_array[count].kpi_message);
+		}
+	}
+
+	snprintf(str_seqno, 12, "%d", seqno);
+	cJSON_AddItemToArray(event, obj = cJSON_CreateObject());
+	cJSON_AddStringToObject(obj, "name", "TizenRT_REPORT");
+	cJSON_AddStringToObject(obj, "dt", str_time);
+	cJSON_AddItemToObject(obj, "kpi", kpi);
+	cJSON_AddStringToObject(obj, "seqno", str_seqno);
+
+	DAWIT_LOG_INFO(DAWIT_TAG_SSM, "Set %d SYS from file list", count);
+}
+
+dawit_result SSM_Send_SYS_logs_from_file(void *table, unsigned int table_size)
+{
+	dawit_result result = DAWIT_SUCCESS;
+	cJSON *root = NULL;
+	cJSON *event = NULL;
+	kpi_file_data *kpi_data_array = (kpi_file_data *)table;
+	unsigned int kpi_data_array_size = table_size ;
+
+	if (kpi_data_array == NULL)
+	{
+		DAWIT_LOG_ERROR(DAWIT_TAG_SSM, "kpi file data table is NULL");
+        return DAWIT_FAIL;
+	}
+
+	DAWIT_LOG_INFO(DAWIT_TAG_SSM, "Start sending SYS logs from file data");
+
+	/* Build JSON: base request + eventlist from table data entry*/
+	make_base_request(&root, SSM_SYSTEM);
+	cJSON_AddItemToObject(root, "eventlist", event = cJSON_CreateArray());
+	SSM_SYS_set_event_from_table(kpi_data_array, kpi_data_array_size, event);
+
+	/* Send via TLS */
+	result = SSM_Send_log_v2(root);
+	if(result == DAWIT_SUCCESS)
+	{
+		SSM_SYS_update_seq_no_by_value(1);
+	}
+
+	/* Clean up the JSON root */
+	if (root != NULL)
+	{
+		cJSON_Delete(root);
+	}
+
+	return result;
+}
+
+int SSM_get_es_interval_time(void)
+{
+	return g_ssm_interval_es_sec;
+}
+
+int SSM_get_sys_interval_time(void)
+{
+	return g_ssm_interval_sys_sec;
+}
+
+#ifdef CONFIG_CRASH_REPORT
+/****************************************************************************
+ * Private Data for Crash Reporter
+ ****************************************************************************/
+
+static int g_ssm_crashrpt_fd = -1;
+static pthread_t g_ssm_crash_reporter;
+static bool g_ssm_crash_reporter_running = false;
+
+/****************************************************************************
+ * Name: ssm_crash_reporter_thread
+ ****************************************************************************/
+
+static void *ssm_crash_reporter_thread(void *arg)
+{
+	int reason;
+
+	if (ioctl(g_ssm_crashrpt_fd, CRASHRPTIOC_REGISTER, 0) < 0) {
+		DAWIT_LOG_ERROR(DAWIT_TAG_SSM, "crashrpt register failed, errno %d\n", errno);
+		g_ssm_crash_reporter_running = false;
+		close(g_ssm_crashrpt_fd);
+		g_ssm_crashrpt_fd = -1;
+		return NULL;
+	}
+
+	DAWIT_LOG_INFO(DAWIT_TAG_SSM, "SSM crash reporter registered and waiting\n");
+
+	for (;;) {
+		/* Parks here until the kernel wakes us from up_assert().
+		 * There is no timeout - the thread waits indefinitely for a crash.
+		 */
+		reason = fin_wait();
+
+		DAWIT_LOG_INFO(DAWIT_TAG_SSM, "SSM crash reporter woken, reason %d\n", reason);
+
+		/* Store logs to file when crash occurs (1000ms = minimum valid time limit) */
+		SSM_Store_logs_to_file(1000);
+
+		DAWIT_LOG_INFO(DAWIT_TAG_SSM, "SSM crash reporter stored logs, notifying driver\n");
+
+		/* Release the asserting thread whether or not the write succeeded */
+		if (ioctl(g_ssm_crashrpt_fd, CRASHRPTIOC_DONE, 0) < 0) {
+			DAWIT_LOG_ERROR(DAWIT_TAG_SSM, "crashrpt done notification failed, errno %d\n", errno);
+		}
+	}
+
+	return NULL;
+}
+
+/****************************************************************************
+ * Name: SSM_crash_reporter_init
+ ****************************************************************************/
+
+dawit_result SSM_crash_reporter_init(void)
+{
+	pthread_attr_t attr;
+	struct sched_param param;
+	int ret;
+
+	if (g_ssm_crash_reporter_running) {
+		DAWIT_LOG_INFO(DAWIT_TAG_SSM, "SSM crash reporter already running\n");
+		return DAWIT_SUCCESS;
+	}
+
+	g_ssm_crashrpt_fd = open(CRASHRPT_DEVPATH, O_RDWR);
+	if (g_ssm_crashrpt_fd < 0) {
+		DAWIT_LOG_ERROR(DAWIT_TAG_SSM, "cannot open %s, errno %d\n", CRASHRPT_DEVPATH, errno);
+		DAWIT_LOG_ERROR(DAWIT_TAG_SSM, "is CONFIG_CRASH_REPORT enabled?\n");
+		return DAWIT_FAIL;
+	}
+
+	pthread_attr_init(&attr);
+	pthread_attr_setstacksize(&attr, 8192);
+
+	/* High priority is required - the reporter must outrank all other threads */
+	param.sched_priority = SCHED_PRIORITY_MAX - 1;
+	pthread_attr_setschedparam(&attr, &param);
+
+	ret = pthread_create(&g_ssm_crash_reporter, &attr, ssm_crash_reporter_thread, NULL);
+	if (ret != 0) {
+		DAWIT_LOG_ERROR(DAWIT_TAG_SSM, "pthread_create failed, %d\n", ret);
+		close(g_ssm_crashrpt_fd);
+		g_ssm_crashrpt_fd = -1;
+		pthread_attr_destroy(&attr);
+		return DAWIT_FAIL;
+	}
+
+	pthread_setname_np(g_ssm_crash_reporter, "ssm_crash_rpt");
+	pthread_detach(g_ssm_crash_reporter);
+	pthread_attr_destroy(&attr);
+
+	g_ssm_crash_reporter_running = true;
+	DAWIT_LOG_INFO(DAWIT_TAG_SSM, "SSM crash reporter initialized\n");
+	return DAWIT_SUCCESS;
+}
+
+/****************************************************************************
+ * Name: SSM_crash_reporter_store_logs
+ ****************************************************************************/
+
+void SSM_crash_reporter_store_logs(int reason)
+{
+	DAWIT_LOG_INFO(DAWIT_TAG_SSM, "SSM crash reporter store logs called, reason %d\n", reason);
+	SSM_Store_logs_to_file(0);
+}
+
+#endif /* CONFIG_CRASH_REPORT */
