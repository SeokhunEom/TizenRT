+#
+# For a description of the syntax of this configuration file,
+# see kconfig-language at https://www.kernel.org/doc/Documentation/kbuild/kconfig-language.txt
+#
+
+config EXAMPLES_CRASHRPT_COMPREHENSIVE_TEST
+	bool "Crash report comprehensive test"
+	default n
+	depends on CRASH_REPORT
+	---help---
+		Comprehensive test application for /dev/crashrpt driver.
+
+		This test application exercises selected crash scenarios that
+		can be triggered from user-space and verifies the crash reports
+		generated by the kernel crash diagnostic capture mechanism.
+
+		Test cases:
+		- TC1: APP_ASSERT - Direct ASSERT(0) from application
+		- TC2: KERNEL_ASSERT - Invalid ioctl to kernel driver
+
+		The application also includes a report verification tool that
+		parses the binary crash reports and validates their contents.
+
+if EXAMPLES_CRASHRPT_COMPREHENSIVE_TEST
+
+config EXAMPLES_CRASHRPT_COMPREHENSIVE_TEST_DIR
+	string "Directory for the reports"
+	default "/mnt"
+	---help---
+		Where the crash reports are written. Must be a writable mount
+		point. The reports are written atomically (temp file + rename)
+		to ensure readers never see partial reports.
+
+config EXAMPLES_CRASHRPT_COMPREHENSIVE_TEST_PRIORITY
+	int "Reporter thread priority"
+	default 254
+	---help---
+		The reporter must outrank every other runnable thread, otherwise
+		it may not be scheduled before the deadline expires and no report
+		will be produced.
+
+config EXAMPLES_CRASHRPT_COMPREHENSIVE_TEST_STACKSIZE
+	int "Reporter thread stack size"
+	default 8192
+	---help---
+		Stack size for the reporter thread. The default is sufficient
+		for writing reports to most filesystems.
+
+endif # EXAMPLES_CRASHRPT_COMPREHENSIVE_TEST
+
+config USER_ENTRYPOINT
+	string
+	default "crashrpt_comprehensive_test_main" if ENTRY_CRASHRPT_COMPREHENSIVE_TEST
