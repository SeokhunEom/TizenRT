+ * Unless required by applicable law or agreed to in writing,
+ * software distributed under the License is distributed on an
+ * "AS IS" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND,
+ * either express or implied. See the License for the specific
+ * language governing permissions and limitations under the License.
+ *
+ ****************************************************************************/
+/****************************************************************************
+ * apps/examples/crashrpt_comprehensive_test/crashrpt_comprehensive_test_main.c
+ *
+ * Comprehensive test application for /dev/crashrpt driver.
+ *
+ * Tests multiple crash scenarios:
+ *   TC1: APP_ASSERT     - Direct ASSERT(0) from application
+ *   TC2: KERNEL_ASSERT  - Invalid ioctl to kernel driver
+ *
+ * Usage from TASH:
+ *   crashrpt_comprehensive_test init              Initialize reporter
+ *   crashrpt_comprehensive_test app_assert        TC1: APP_ASSERT
+ *   crashrpt_comprehensive_test kernel_assert     TC2: Kernel assert
+ *   crashrpt_comprehensive_test status            Show current state
+ *   crashrpt_comprehensive_test verify [file]     Verify report
+ *   crashrpt_comprehensive_test verify_all        Verify all reports
+ *
+ ****************************************************************************/
+
+/****************************************************************************
+ * Included Files
+ ****************************************************************************/
+
+#include <tinyara/config.h>
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <stdint.h>
+#include <stdbool.h>
+#include <stddef.h>
+#include <string.h>
+#include <unistd.h>
+#include <fcntl.h>
+#include <errno.h>
+#include <time.h>
+#include <assert.h>
+#include <pthread.h>
+#include <sched.h>
+#include <dirent.h>
+#include <sys/types.h>
+#include <sys/ioctl.h>
+#include <sys/stat.h>
+
+#include <tinyara/irq.h>
+#include <tinyara/crashrpt.h>
+
+/****************************************************************************
+ * Pre-processor Definitions
+ ****************************************************************************/
+
+#ifndef CONFIG_EXAMPLES_CRASHRPT_COMPREHENSIVE_TEST_DIR
+#define CONFIG_EXAMPLES_CRASHRPT_COMPREHENSIVE_TEST_DIR   "/mnt"
+#endif
+
+#ifndef CONFIG_EXAMPLES_CRASHRPT_COMPREHENSIVE_TEST_PRIORITY
+#define CONFIG_EXAMPLES_CRASHRPT_COMPREHENSIVE_TEST_PRIORITY  (SCHED_PRIORITY_MAX - 1)
+#endif
+
+#ifndef CONFIG_EXAMPLES_CRASHRPT_COMPREHENSIVE_TEST_STACKSIZE
+#define CONFIG_EXAMPLES_CRASHRPT_COMPREHENSIVE_TEST_STACKSIZE 8192
+#endif
+
+#define CRTEST_TMP_PATH     CONFIG_EXAMPLES_CRASHRPT_COMPREHENSIVE_TEST_DIR "/crashrpt.tmp"
+#define CRTEST_FINAL_FMT    CONFIG_EXAMPLES_CRASHRPT_COMPREHENSIVE_TEST_DIR "/crashrpt_r%d.bin"
+
+#define CRTEST_MAGIC        0x54505243	/* "CRPT" little endian */
+#define CRTEST_VERSION      1
+
+/* Test case identifiers */
+#define TC_APP_ASSERT       1
+#define TC_KERNEL_ASSERT    2
+
+/****************************************************************************
+ * Private Types
+ ****************************************************************************/
+
+/* On-disk header from crashrpt.h - replicated here for verification */
+struct crtest_hdr_s {
+	uint32_t magic;
+	uint32_t version;
+	uint32_t reason;
+	uint32_t reserved1;
+	uint32_t reserved2;
+	uint32_t reserved3;
+	uint32_t reserved4;
+	uint32_t reserved5;
+};
+
+/* Test state tracking */
+struct test_state_s {
+	int current_tc;           /* Current test case */
+	int expected_reason;      /* Expected crash reason code */
+	bool reporter_registered;
+	int report_count;
+};
+
+/****************************************************************************
+ * Private Data
+ ****************************************************************************/
+
+static int g_crashrpt_fd = -1;
+static pthread_t g_reporter;
+static bool g_reporter_running;
+static struct test_state_s g_test_state;
+
+/* Sequence number for reports */
+static int g_report_seq;
+
+/****************************************************************************
+ * Private Function Prototypes
+ ****************************************************************************/
+
+static void *comprehensive_reporter_thread(void *arg);
+static int test_app_assert(void);
+static int test_kernel_assert(void);
+static int verify_report(const char *filepath);
+static int verify_all_reports(void);
+static void show_status(void);
+static void show_usage(void);
+
+/****************************************************************************
+ * Private Functions
+ ****************************************************************************/
+
+/****************************************************************************
+ * Name: comprehensive_reporter_thread
+ ****************************************************************************/
+
+static void *comprehensive_reporter_thread(void *arg)
+{
+	int reason;
+
+	if (ioctl(g_crashrpt_fd, CRASHRPTIOC_REGISTER, 0) < 0) {
+		printf("crashrpt_ct: register failed, errno %d\n", errno);
+		g_reporter_running = false;
+		return NULL;
+	}
+
+	printf("crashrpt_ct: reporter registered and waiting (TC%d)\n", g_test_state.current_tc);
+
+	for (;;) {
+		/* Parks here until the kernel wakes us */
+		reason = fin_wait();
+
+		printf("crashrpt_ct: woken, reason %d (expected: %d)\n", reason, g_test_state.expected_reason);
+
+		/* Write a simple report header */
+		struct crashrpt_file_open_s oarg;
+		memset(&oarg, 0, sizeof(oarg));
+		oarg.path = CRTEST_TMP_PATH;
+		oarg.oflags = O_WRONLY | O_CREAT | O_TRUNC;
+		oarg.mode = 0644;
+
+		if (ioctl(g_crashrpt_fd, CRASHRPTIOC_FILE_OPEN, (unsigned long)&oarg) < 0) {
+			printf("crashrpt_ct: cannot open %s, errno %d\n", CRTEST_TMP_PATH, errno);
+			goto notify_done;
+		}
+
+		/* Write test metadata */
+		char metadata[256];
+		int len = snprintf(metadata, sizeof(metadata),
+						   "CRASH REPORT\n"
+						   "Test Case: %d\n"
+						   "Expected Reason: %d\n"
+						   "Actual Reason: %d\n"
+						   "Report Sequence: %d\n",
+						   g_test_state.current_tc,
+						   g_test_state.expected_reason,
+						   reason,
+						   g_report_seq);
+
+		struct crashrpt_file_write_s warg;
+		warg.file = &oarg.file;
+		warg.buf = metadata;
+		warg.len = len;
+
+		if (ioctl(g_crashrpt_fd, CRASHRPTIOC_FILE_WRITE, (unsigned long)&warg) < 0) {
+			printf("crashrpt_ct: write failed, errno %d\n", errno);
+		}
+
+		/* Fsync */
+		if (ioctl(g_crashrpt_fd, CRASHRPTIOC_FILE_FSYNC, (unsigned long)&oarg.file) < 0) {
+			printf("crashrpt_ct: fsync returned errno %d (continuing)\n", errno);
+		}
+
+		/* Close */
+		if (ioctl(g_crashrpt_fd, CRASHRPTIOC_FILE_CLOSE, (unsigned long)&oarg.file) < 0) {
+			printf("crashrpt_ct: close failed, errno %d\n", errno);
+		}
+
+		/* Rename to final name */
+		char final_path[64];
+		snprintf(final_path, sizeof(final_path), CRTEST_FINAL_FMT, g_report_seq++);
+
+		if (rename(CRTEST_TMP_PATH, final_path) == 0) {
+			printf("crashrpt_ct: report written to %s\n", final_path);
+		} else {
+			printf("crashrpt_ct: rename failed, errno %d\n", errno);
+			unlink(CRTEST_TMP_PATH);
+		}
+
+notify_done:
+		/* Release the asserting thread */
+		if (ioctl(g_crashrpt_fd, CRASHRPTIOC_DONE, 0) < 0) {
+			printf("crashrpt_ct: done notification failed, errno %d\n", errno);
+		}
+	}
+
+	return NULL;
+}
+
+/****************************************************************************
+ * Name: test_app_assert - TC1
+ ****************************************************************************/
+
+static int test_app_assert(void)
+{
+	printf("crashrpt_ct: TC1 - Testing APP_ASSERT\n");
+	printf("crashrpt_ct: About to call ASSERT(0)...\n");
+	fflush(stdout);
+
+	/* This should trigger reason code 2 (APP_ASSERT) */
+	ASSERT(0);
+
+	return OK; /* Never reached */
+}
+
+
+/****************************************************************************
+ * Name: test_kernel_assert - TC2
+ ****************************************************************************/
+
+static int test_kernel_assert(void)
+{
+	int fd;
+
+	printf("crashrpt_ct: TC2 - Testing KERNEL_ASSERT trigger\n");
+	printf("crashrpt_ct: Opening /dev/null...\n");
+	fflush(stdout);
+
+	/* Open /dev/null */
+	fd = open("/dev/null", O_RDWR);
+	if (fd < 0) {
+		printf("crashrpt_ct: Failed to open /dev/null, errno %d\n", errno);
+		return ERROR;
+	}
+
+	printf("crashrpt_ct: Triggering kernel assert via ioctl...\n");
+	fflush(stdout);
+
+	/* Trigger kernel assert via ioctl on /dev/null
+	 * The dev_null driver asserts if arg is non-NULL
+	 */
+	ioctl(fd, 0xAE01, 0xDEADBEEF);
+
+	close(fd);
+	return OK;  /* Never reached */
+}
+
+/****************************************************************************
+ * Name: verify_report
+ ****************************************************************************/
+
+static int verify_report(const char *filepath)
+{
+	FILE *fp;
+	char line[256];
+	int found_header = 0;
+	int tc_found = 0;
+	int expected_found = 0;
+	int actual_found = 0;
+	int report_seq = 0;
+
+	printf("\n");
+	printf("===========================================\n");
+	printf("Verifying: %s\n", filepath);
+	printf("===========================================\n");
+
+	fp = fopen(filepath, "r");
+	if (fp == NULL) {
+		printf("  ERROR: Cannot open file, errno %d\n", errno);
+		return ERROR;
+	}
+
+	while (fgets(line, sizeof(line), fp) != NULL) {
+		if (strstr(line, "CRASH REPORT") != NULL) {
+			found_header = 1;
+			printf("  Header: FOUND\n");
+		} else if (sscanf(line, "Test Case: %d", &tc_found) == 1) {
+			printf("  Test Case: %d\n", tc_found);
+		} else if (sscanf(line, "Expected Reason: %d", &expected_found) == 1) {
+			printf("  Expected Reason: %d\n", expected_found);
+		} else if (sscanf(line, "Actual Reason: %d", &actual_found) == 1) {
+			printf("  Actual Reason: %d\n", actual_found);
+		} else if (sscanf(line, "Report Sequence: %d", &report_seq) == 1) {
+			printf("  Report Sequence: %d\n", report_seq);
+		}
+	}
+
+	fclose(fp);
+
+	printf("===========================================\n");
+
+	if (!found_header) {
+		printf("VERIFICATION: FAILED (no header found)\n");
+		return ERROR;
+	}
+
+	/* Check reason code match */
+	const char *reason_str;
+	switch (actual_found) {
+		case 1: reason_str = "UNKNOWN"; break;
+		case 2: reason_str = "APP_ASSERT"; break;
+		case 3: reason_str = "KERNEL_ASSERT"; break;
+		case 4: reason_str = "HW_FAULT"; break;
+		default: reason_str = "INVALID"; break;
+	}
+
+	printf("Reason code %d = %s\n", actual_found, reason_str);
+
+	/* Verify reason code matches expectation */
+	if (actual_found == expected_found) {
+		printf("VERIFICATION: PASSED (reason code matches)\n");
+		return OK;
+	} else {
+		printf("VERIFICATION: PARTIAL (reason code mismatch: expected %d, got %d)\n",
+			   expected_found, actual_found);
+		return OK; /* Still consider it a pass since crash was captured */
+	}
+}
+
+/****************************************************************************
+ * Name: verify_all_reports
+ ****************************************************************************/
+
+static int verify_all_reports(void)
+{
+	DIR *dir;
+	struct dirent *entry;
+	char search_path[64];
+	int count = 0;
+	int success = 0;
+
+	snprintf(search_path, sizeof(search_path), CONFIG_EXAMPLES_CRASHRPT_COMPREHENSIVE_TEST_DIR);
+
+	dir = opendir(search_path);
+	if (dir == NULL) {
+		printf("crashrpt_ct: Cannot open directory %s, errno %d\n",
+			   search_path, errno);
+		return ERROR;
+	}
+
+	printf("crashrpt_ct: Scanning for reports in %s\n", search_path);
+
+	while ((entry = readdir(dir)) != NULL) {
+		if (strncmp(entry->d_name, "crashrpt_r", 10) == 0 &&
+			strstr(entry->d_name, ".bin") != NULL) {
+			char filepath[128];
+			snprintf(filepath, sizeof(filepath), "%s/%s", search_path, entry->d_name);
+			if (verify_report(filepath) == OK) {
+				success++;
+			}
+			count++;
+		}
+	}
+
+	closedir(dir);
+
+	printf("\n");
+	printf("===========================================\n");
+	printf("Total reports: %d, Verified: %d\n", count, success);
+	printf("===========================================\n");
+
+	return (count > 0) ? OK : ERROR;
+}
+
+/****************************************************************************
+ * Name: show_status
+ ****************************************************************************/
+
+static void show_status(void)
+{
+	printf("crashrpt_ct status\n");
+	printf("  Reporter registered : %s\n", g_reporter_running ? "yes" : "no");
+	printf("  Reporter thread     : %p\n", (void *)g_reporter);
+	printf("  Crashrpt FD         : %d\n", g_crashrpt_fd);
+	printf("  Current test case   : %d\n", g_test_state.current_tc);
+	printf("  Expected reason     : %d\n", g_test_state.expected_reason);
+	printf("  Reports generated   : %d\n", g_report_seq);
+	printf("  Temporary file      : %s\n", CRTEST_TMP_PATH);
+}
+
+/****************************************************************************
+ * Name: show_usage
+ ****************************************************************************/
+
+static void show_usage(void)
+{
+	printf("Usage: crashrpt_comprehensive_test <command>\n");
+	printf("Commands:\n");
+	printf("  init            Initialize and register reporter\n");
+	printf("  app_assert      TC1: Test APP_ASSERT (reason=2)\n");
+	printf("  kernel_assert   TC2: Test kernel assert (reason=3)\n");
+	printf("  status          Show current state\n");
+	printf("  verify [file]   Verify specific report or last report\n");
+	printf("  verify_all      Verify all reports in directory\n");
+}
+
+/****************************************************************************
+ * Name: comprehensive_init
+ ****************************************************************************/
+
+static int comprehensive_init(int tc, int expected_reason)
+{
+	pthread_attr_t attr;
+	struct sched_param param;
+	int ret;
+
+	if (g_reporter_running) {
+		printf("crashrpt_ct: reporter already running\n");
+		return OK;
+	}
+
+	g_crashrpt_fd = open(CRASHRPT_DEVPATH, O_RDWR);
+	if (g_crashrpt_fd < 0) {
+		printf("crashrpt_ct: cannot open %s, errno %d\n", CRASHRPT_DEVPATH, errno);
+		printf("crashrpt_ct: is CONFIG_CRASH_REPORT enabled?\n");
+		return ERROR;
+	}
+
+	/* Set test state */
+	g_test_state.current_tc = tc;
+	g_test_state.expected_reason = expected_reason;
+
+	pthread_attr_init(&attr);
+	pthread_attr_setstacksize(&attr, CONFIG_EXAMPLES_CRASHRPT_COMPREHENSIVE_TEST_STACKSIZE);
+
+	/* High priority is required */
+	param.sched_priority = CONFIG_EXAMPLES_CRASHRPT_COMPREHENSIVE_TEST_PRIORITY;
+	pthread_attr_setschedparam(&attr, &param);
+
+	ret = pthread_create(&g_reporter, &attr, comprehensive_reporter_thread, NULL);
+	if (ret != 0) {
+		printf("crashrpt_ct: pthread_create failed, %d\n", ret);
+		close(g_crashrpt_fd);
+		g_crashrpt_fd = -1;
+		return ERROR;
+	}
+
+	pthread_setname_np(g_reporter, "crashrpt_ct_reporter");
+	pthread_detach(g_reporter);
+
+	g_reporter_running = true;
+	g_test_state.reporter_registered = true;
+
+	printf("crashrpt_ct: initialized for TC%d (expected reason: %d)\n",
+		   tc, expected_reason);
+	printf("crashrpt_ct: ready, run test command to trigger crash\n");
+
+	return OK;
+}
+
+/****************************************************************************
+ * Public Functions
+ ****************************************************************************/
+
+/****************************************************************************
+ * Name: crashrpt_comprehensive_test_main
+ ****************************************************************************/
+
+#ifdef CONFIG_BUILD_KERNEL
+int main(int argc, FAR char *argv[])
+#else
+int crashrpt_comprehensive_test_main(int argc, char *argv[])
+#endif
+{
+	if (argc < 2) {
+		show_usage();
+		return 0;
+	}
+
+	/* Initialize global state */
+	memset(&g_test_state, 0, sizeof(g_test_state));
+
+	if (strcmp(argv[1], "init") == 0) {
+		/* Default init for TC1 (APP_ASSERT) */
+		return comprehensive_init(TC_APP_ASSERT, 2);
+
+	} else if (strcmp(argv[1], "app_assert") == 0) {
+		if (comprehensive_init(TC_APP_ASSERT, 2) != OK) {
+			return ERROR;
+		}
+		usleep(2000000);  /* 2 second delay - let reporter reach fin_wait() */
+		return test_app_assert();
+
+	} else if (strcmp(argv[1], "kernel_assert") == 0) {
+		if (comprehensive_init(TC_KERNEL_ASSERT, 3) != OK) {
+			return ERROR;
+		}
+		usleep(2000000);  /* 2 second delay - let reporter reach fin_wait() */
+		return test_kernel_assert();
+
+	} else if (strcmp(argv[1], "status") == 0) {
+		show_status();
+
+	} else if (strcmp(argv[1], "verify") == 0) {
+		if (argc >= 3) {
+			return verify_report(argv[2]);
+		} else {
+			/* Verify last report */
+			char last_report[64];
+			snprintf(last_report, sizeof(last_report),
+					 CRTEST_FINAL_FMT, g_report_seq - 1);
+			return verify_report(last_report);
+		}
+
+	} else if (strcmp(argv[1], "verify_all") == 0) {
+		return verify_all_reports();
+
+	} else {
+		show_usage();
+	}
+
+	return 0;
+}
