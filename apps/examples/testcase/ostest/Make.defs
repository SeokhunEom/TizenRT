############################################################################
# apps/examples/testcase/ostest/Make.defs
#
# SPDX-License-Identifier: Apache-2.0
############################################################################

ifeq ($(CONFIG_TESTING_OSTEST),y)

CSRCS += ostest_entry.c restart.c ostest_sighelper.c

ifeq ($(CONFIG_DEV_NULL),y)
CSRCS += dev_null.c
endif

ifeq ($(CONFIG_TESTING_OSTEST_AIO),y)
CSRCS += aio.c
endif

ifeq ($(CONFIG_ARCH_FPU),y)
ifeq ($(CONFIG_BUILD_FLAT),y)
ifneq ($(CONFIG_TESTING_OSTEST_FPUTESTDISABLE),y)
CSRCS += fpu.c
endif
endif
endif

ifeq ($(CONFIG_SCHED_WAITPID),y)
CSRCS += waitpid.c
endif

ifneq ($(CONFIG_DISABLE_PTHREAD),y)
CSRCS += cancel.c cond.c mutex.c sem.c semtimed.c barrier.c
CSRCS += pthread_rwlock.c pthread_rwlock_cancel.c schedlock.c

ifeq ($(CONFIG_SCHED_WAITPID),y)
CSRCS += pthread_exit.c
endif

ifneq ($(CONFIG_TLS_NELEM),)
ifneq ($(CONFIG_TLS_NELEM),0)
CSRCS += specific.c
endif
endif

ifneq ($(CONFIG_TLS_NCLEANUP),)
ifneq ($(CONFIG_TLS_NCLEANUP),0)
CSRCS += pthread_cleanup.c
endif
endif

ifneq ($(CONFIG_PTHREAD_MUTEX_UNSAFE),y)
CSRCS += robust.c
endif

ifeq ($(CONFIG_PTHREAD_MUTEX_TYPES),y)
CSRCS += rmutex.c
endif

ifeq ($(CONFIG_FS_NAMED_SEMAPHORES),y)
CSRCS += nsem.c
endif

endif

ifneq ($(CONFIG_DISABLE_MQUEUE),y)
ifneq ($(CONFIG_DISABLE_PTHREAD),y)
CSRCS += timedmqueue.c
ifneq ($(CONFIG_DISABLE_SIGNALS),y)
CSRCS += mqueue.c
endif
endif
endif

ifeq ($(CONFIG_ENABLE_ALL_SIGNALS),y)
CSRCS += sighand.c signest.c
ifneq ($(CONFIG_DISABLE_POSIX_TIMERS),y)
CSRCS += posixtimer.c
endif
endif

ifeq ($(CONFIG_SIG_EVTHREAD),y)
ifneq ($(CONFIG_DISABLE_POSIX_TIMERS),y)
CSRCS += sigev_thread.c
endif
endif

ifeq ($(CONFIG_ARCH_HAVE_VFORK),y)
CSRCS += vfork.c
endif

ifeq ($(CONFIG_ARCH_HAVE_FORK),y)
CSRCS += fork.c
endif

ifeq ($(CONFIG_ARCH_SETJMP_H),y)
CSRCS += setjmp.c
endif

# These upstream tests depend on NuttX interfaces that TizenRT does not
# currently expose.  Keep their source unchanged and link explicit skip
# adapters so the imported suite remains traceable.
CSRCS += ostest_unsupported.c

DEPPATH += --dep-path ostest
VPATH += :ostest
endif
