config EXAMPLES_HEALTH_MONITOR_QEMU
	bool "Temporary QEMU Health Monitor verification"
	default n
	depends on HEALTH_MONITOR && BUILD_FLAT && (ARCH_CHIP_LM3S6965 || ARCH_CHIP_MPS2_AN505) && !SMP && !DISABLE_PTHREAD
	---help---
		Test-only real-kernel API and lifecycle scenarios plus controlled-time
		system-timer probes. Do not enable in a product firmware.

config QEMU_HEALTH_MONITOR_CAPACITY
	int "Temporary Health Monitor heap capacity"
	default MAX_TASKS
	range 1 MAX_TASKS
	depends on EXAMPLES_HEALTH_MONITOR_QEMU
