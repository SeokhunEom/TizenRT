config EXAMPLES_HEALTH_MONITOR
	bool "Health monitor validation example"
	default n
	depends on HEALTH_MONITOR && !DISABLE_PTHREAD
	---help---
		Enable the health_monitor command for normal kicks, explicit stop,
		thread exit, SMP lifecycle stress and intentional timeout testing.
		No thread is monitored until a command explicitly starts monitoring.
		The expire command deliberately triggers PANIC and board reset.
