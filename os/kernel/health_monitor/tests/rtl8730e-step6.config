# Test-only overlay for rtl8730e/loadable_ext_ddr_st7785.
# Apply in a temporary configured tree. Product activation is stage 7.
CONFIG_HEALTH_MONITOR=y
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_FOR_IRQ=y
CONFIG_WATCHDOG_FOR_IRQ_INTERVAL=5000
# Selected by ARCH_CHIP_AMEBASMART; explicit for direct .config overlays.
CONFIG_ARCH_HAVE_WDOG_WAKEUP=y
CONFIG_PM=y
CONFIG_PM_TICKSUPPRESS=y
CONFIG_PM_TIMEDWAKEUP=y
CONFIG_SYSTEM_REBOOT_REASON=y
